generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum Role {
  PATIENT
  STAFF
  CLINICIAN
  ADMIN
}

enum ConsultationStage {
  SUBMITTED
  CLINICIAN_REVIEWING
  MDT_CONSULTATION
  FINAL_SUMMARY
}

enum EntryStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum HighlightSource {
  HUMAN
  MODEL
}

enum FeedbackVerdict {
  AGREE
  DISAGREE
  EDIT
  PIN
}

model Clinic {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// Code patients enter to self-register with this clinic; null disables self-registration.
  enrollmentCode String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users   User[]
  entries CareEntry[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String
  phone        String?
  dateOfBirth  String?
  employeeCode String?
  title        String?
  department   String?
  clinicId     String?
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authoredEntries    CareEntry[]             @relation("EntryAuthor")
  patientEntries     CareEntry[]             @relation("EntryPatient")
  revisions          EntryRevision[]
  comments           Comment[]
  highlights         Highlight[]
  highlightFeedbacks HighlightFeedback[]
  auditLogs          AuditLog[]
  entryViews         CareEntryViewer[]
  createdActions     CareAction[]            @relation("ActionCreator")
  resolvedActions    CareAction[]            @relation("ActionResolver")
  agentRuns          AgentRun[]              @relation("AgentRunActor")
  patientAgentRuns   AgentRun[]              @relation("AgentRunPatient")
  decidedProposals   AgentFollowupProposal[] @relation("ProposalDecider")
  riskAssessments    RiskAssessment[]        @relation("RiskPatient")
  isServiceAccount   Boolean                 @default(false)
  status             UserStatus              @default(ACTIVE)
  failedLoginCount   Int                     @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Incremented on password change, disable, or "sign out everywhere": older sessions stop working.
  sessionVersion     Int                     @default(0)
  passwordChangedAt  DateTime?
  invitations        Invitation[]            @relation("InvitationUser")
  invitationsSent    Invitation[]            @relation("InvitationCreator")

  @@index([clinicId, role])
  @@index([employeeCode])
}

model CareEntry {
  id                String            @id @default(cuid())
  clinicId          String
  clinic            Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId         String
  patient           User              @relation("EntryPatient", fields: [patientId], references: [id], onDelete: Restrict)
  authorId          String
  author            User              @relation("EntryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title             String
  body              String            @default("")
  version           Int               @default(1)
  status            EntryStatus       @default(DRAFT)
  encounterAt       DateTime
  consultationStage ConsultationStage @default(SUBMITTED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  revisions   EntryRevision[]
  comments    Comment[]
  highlights  Highlight[]
  viewers     CareEntryViewer[]
  careActions CareAction[]

  @@index([clinicId, patientId])
  @@index([patientId, encounterAt])
}

model EntryRevision {
  id          String    @id @default(cuid())
  careEntryId String
  careEntry   CareEntry @relation(fields: [careEntryId], references: [id], onDelete: Cascade)
  editorId    String
  editor      User      @relation(fields: [editorId], references: [id], onDelete: Restrict)
  version     Int
  body        String
  summary     String?
  createdAt   DateTime  @default(now())

  highlights Highlight[]

  @@unique([careEntryId, version])
  @@index([careEntryId])
}

enum CareActionStatus {
  PENDING
  RESOLVED
}

model CareAction {
  id             String           @id @default(cuid())
  patientId      String
  careEntryId    String
  careEntry      CareEntry        @relation(fields: [careEntryId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User             @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedById   String?
  resolvedBy     User?            @relation("ActionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  sourceKey      String           @unique
  kind           String
  text           String
  status         CareActionStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedByRole String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([patientId, status])
  @@index([careEntryId])
}

model Comment {
  id          String    @id @default(cuid())
  careEntryId String
  careEntry   CareEntry @relation(fields: [careEntryId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([careEntryId])
}

model CareEntryViewer {
  id          String    @id @default(cuid())
  careEntryId String
  careEntry   CareEntry @relation(fields: [careEntryId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  viewedAt    DateTime  @default(now())

  @@unique([careEntryId, userId])
  @@index([careEntryId])
}

model Highlight {
  id                String          @id @default(cuid())
  careEntryId       String
  careEntry         CareEntry       @relation(fields: [careEntryId], references: [id], onDelete: Cascade)
  revisionId        String?
  revision          EntryRevision?  @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  startOffset       Int
  endOffset         Int
  excerpt           String
  provenancePointer String?
  label             String?
  source            HighlightSource @default(HUMAN)
  confidence        Float?
  createdAt         DateTime        @default(now())

  feedbacks HighlightFeedback[]

  @@index([careEntryId])
  @@index([revisionId])
}

model HighlightFeedback {
  id          String          @id @default(cuid())
  highlightId String
  highlight   Highlight       @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  verdict     FeedbackVerdict
  note        String?
  createdAt   DateTime        @default(now())

  @@unique([highlightId, userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model FeatureWeight {
  id          String   @id @default(cuid())
  featureKey  String   @unique
  weight      Float
  description String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProposalStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

/// One agent execution. Stores outcome, usage and a metadata-only trace (tool names, sizes, timings);
/// never raw tool payloads. The summary is post-guardrail and already PHI-redacted.
model AgentRun {
  id               String         @id @default(cuid())
  agent            String
  clinicId         String
  patientId        String
  patient          User           @relation("AgentRunPatient", fields: [patientId], references: [id], onDelete: Cascade)
  actorId          String
  actor            User           @relation("AgentRunActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorRole        Role
  promptVersion    String
  promptHash       String
  model            String
  servedModel      String?
  fallbackUsed     Boolean        @default(false)
  status           AgentRunStatus @default(RUNNING)
  outcome          String?
  errorKind        String?
  steps            Int            @default(0)
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  cacheReadTokens  Int            @default(0)
  cacheWriteTokens Int            @default(0)
  durationMs       Int?
  trace            Json?
  summary          Json?
  guardrail        Json?
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?

  proposals AgentFollowupProposal[]

  @@index([patientId, actorRole, startedAt])
  @@index([actorId, startedAt])
}

/// A follow-up the agent drafted. It becomes a CareAction only when a clinician accepts it.
model AgentFollowupProposal {
  id           String         @id @default(cuid())
  runId        String
  run          AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  patientId    String
  ref          String
  sourceNoteId String
  kind         String
  text         String
  rationale    String
  status       ProposalStatus @default(PROPOSED)
  careActionId String?
  decidedById  String?
  decidedBy    User?          @relation("ProposalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([patientId, status])
  @@index([runId])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskAssessmentStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SUPERSEDED
}

/// Patient-level acuity from the risk triage agent (or the deterministic rules when no model is
/// available). Rows double as the work queue: note writes enqueue PENDING rows, a worker runs them.
model RiskAssessment {
  id             String               @id @default(cuid())
  clinicId       String
  patientId      String
  patient        User                 @relation("RiskPatient", fields: [patientId], references: [id], onDelete: Cascade)
  status         RiskAssessmentStatus @default(PENDING)
  trigger        String
  requestedById  String?
  attempts       Int                  @default(0)
  inputHash      String?
  method         String?
  modelLevel     RiskLevel?
  floorLevel     RiskLevel?
  finalLevel     RiskLevel?
  review         String?
  confidence     String?
  summary        String?
  drivers        Json?
  floorReasons   Json?
  guardrail      Json?
  agentRunId     String?
  error          String?
  overrideLevel  RiskLevel?
  overrideReason String?
  overriddenById String?
  overriddenAt   DateTime?
  createdAt      DateTime             @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([patientId, createdAt])
  @@index([patientId, status, createdAt])
  @@index([status, createdAt])
  @@index([clinicId, status])
}

/// One-time activation link for an invited account (staff, clinician, or a patient created by staff).
/// Only a SHA-256 hash of the token is stored.
model Invitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdById String?
  createdBy   User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
