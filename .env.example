DATABASE_URL="file:./dev.db"

# --- Session signing (required in production, >= 32 characters) ---
# NIGHTINGALE_SESSION_SECRET=
# Raw x-user-id header auth for the demo; defaults to on outside production.
# NIGHTINGALE_ALLOW_HEADER_AUTH=true

# --- Handover agent ---
# ANTHROPIC_API_KEY=            # required for the live agent and paid evaluations
# NIGHTINGALE_AGENT_CLIENT=simulated   # offline rule policy for demos without a key
# NIGHTINGALE_AGENT_MODEL=claude-opus-5-5
# NIGHTINGALE_AGENT_EFFORT=medium      # low | medium | high | xhigh | max
# NIGHTINGALE_AGENT_PROMPT=handover-v2 # handover-v1 | handover-v2
# NIGHTINGALE_AGENT_MAX_STEPS=12
# NIGHTINGALE_AGENT_TOKEN_BUDGET=400000
# NIGHTINGALE_AGENT_DEADLINE_MS=180000
# NIGHTINGALE_AGENT_FALLBACKS=default  # set to "off" to disable server-side refusal fallback
# NIGHTINGALE_AGENT_RATE_LIMIT=6/600   # runs per actor / window seconds
