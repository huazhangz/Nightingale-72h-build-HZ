DATABASE_URL="file:./dev.db"

# --- Sessions and public URL ---
# Required in production (>= 32 characters). Outside production a random per-process secret is used,
# so development sessions end when the server restarts.
# NIGHTINGALE_SESSION_SECRET=
# Origin used in activation links (recommended behind a proxy), e.g. https://nightingale.example.org
# NIGHTINGALE_PUBLIC_URL=

# --- Demo and test switches (never in production) ---
# Shows demo sign-in shortcuts on /login and serves /api/auth/demo-accounts.
# NIGHTINGALE_DEMO_MODE=true
# Accepts a raw x-user-id header instead of a session (tests only; ignored when NODE_ENV=production).
# NIGHTINGALE_ALLOW_HEADER_AUTH=true

# --- Agents (risk triage and handover) ---
# ANTHROPIC_API_KEY=                   # enables the live agents and paid evaluations
# NIGHTINGALE_AGENTS_ENABLED=true      # "false" switches every model call off; rule-based features keep working
# NIGHTINGALE_AGENT_CLIENT=simulated   # offline rule policies for demos without a key (labelled in the UI)
#                                      # "gemini": same agents on Google Gemini through the transport adapter
# GEMINI_API_KEY=                      # needed when NIGHTINGALE_AGENT_CLIENT=gemini and for gemini eval variants
# NIGHTINGALE_GEMINI_MIN_INTERVAL_MS=0 # spacing between Gemini requests; ~6500 stays under a 10 requests/min free tier
# NIGHTINGALE_GEMINI_API=native        # "openai": OpenAI-compatible endpoint, key sent as Authorization: Bearer
#                                      # (use when a network proxy injects the key; set GEMINI_API_KEY=proxy-injected,
#                                      # and NODE_USE_ENV_PROXY=1 so Node's fetch goes through the proxy)
# NIGHTINGALE_AGENT_MODEL=claude-opus-5-5  # default gemini-2.5-flash when the client is gemini
# NIGHTINGALE_AGENT_EFFORT=medium      # low | medium | high | xhigh | max
# NIGHTINGALE_AGENT_PROMPT=handover-v2 # handover agent prompt: handover-v1 | handover-v2
# NIGHTINGALE_AGENT_MAX_STEPS=12       # model turns per run (the risk agent is capped at 8)
# NIGHTINGALE_AGENT_MAX_TOKENS=16000   # max output tokens per turn
# NIGHTINGALE_AGENT_TOKEN_BUDGET=400000
# NIGHTINGALE_AGENT_DEADLINE_MS=180000
# NIGHTINGALE_AGENT_FALLBACKS=default  # "off" disables server-side refusal fallback
# NIGHTINGALE_AGENT_RATE_LIMIT=6/600   # handover runs per user / window seconds

# --- Live evaluations ---
# NIGHTINGALE_EVAL_MAX_USD=4.5         # hard spend cap across live checks and evaluations (measured cost, list prices)
# NIGHTINGALE_EVAL_SPEND_FILE=evals/results/spend-ledger.json

# --- Risk triage queue ---
# NIGHTINGALE_RISK_AUTORUN=on          # "off": do not drain the queue after requests (use the cron endpoint)
# Enables POST /api/agent/risk/drain with header x-cron-secret (>= 16 characters; 404 when unset).
# NIGHTINGALE_CRON_SECRET=
