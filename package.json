{
  "name": "nightingale-72h-build-hz",
  "version": "0.1.0",
  "private": true,
  "description": "Longitudinal patient note and AI clinical platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run tests/test_ui_refresh.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "eval": "tsx --conditions=react-server evals/run.ts",
    "eval:smoke": "tsx --conditions=react-server evals/run.ts --variants oracle,null,rules,rules-noisy --reps 3 --k 1,3 --out evals/results/smoke --assert-baselines",
    "eval:risk": "tsx --conditions=react-server evals/risk/run.ts",
    "eval:risk:smoke": "tsx --conditions=react-server evals/risk/run.ts --variants rules,simulated,oracle --reps 1 --out evals/results/risk-smoke --assert-baselines",
    "agent:live-check": "tsx --conditions=react-server scripts/agent-live-check.ts",
    "eval:regrade": "tsx --conditions=react-server evals/regrade.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@prisma/client": "^6.14.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "19.2.18",
    "jsdom": "^26.1.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.18"
  }
}
